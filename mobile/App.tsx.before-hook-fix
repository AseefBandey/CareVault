    {records.some(r => r.tags.length) && !settings.simpleMode ? <><Text style={[styles.fieldLabel, { color: c.muted, marginTop: 12 }]}>Condition / topic tags</Text><ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 7, paddingVertical: 9 }}><Chip label="All tags" active={!tagFilter} onPress={() => setTagFilter('')} />{[...new Set(records.flatMap(r => r.tags))].filter(Boolean).slice(0, 30).map(tag => <Chip key={tag} label={tag} active={tagFilter === tag} onPress={() => setTagFilter(tagFilter === tag ? '' : tag)} />)}</ScrollView></> : null}
    {filteredRecords.length ? <View style={{ marginTop: 10 }}>{filteredRecords.map(r => <RecordTile key={r.id} record={r} largeText={settings.largeText} onPress={() => { setSelectedRecord(r); setGlossaryTerm(''); openView('detail'); }} onFavorite={() => toggleFavorite(r)} onExplain={() => { setGlossaryTerm(r.labValues[0]?.name || r.medicines[0] || r.title); setSelectedRecord(null); openView('detail'); }} />)}</View> : <Card style={{ marginTop: 10 }}><EmptyState title="No matching records" body="Try a different word or filter. Add a document to start building your timeline." /></Card>}
