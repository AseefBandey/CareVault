      <SettingToggle title="Read summaries aloud" subtitle="Enable the read-out action on records" value={settings.voiceReadout} onChange={v => setSettings(p => ({ ...p, voiceReadout: v }))} />
      <Text style={[styles.fieldLabel, { color: c.text, marginBottom: 8, marginTop: 10 }]}>Language preference</Text><View style={styles.inlineWrap}><Chip label="English" active={settings.language === 'English'} onPress={() => setSettings(p => ({ ...p, language: 'English' }))} /><Chip label="اردو" active={settings.language === 'اردو'} onPress={() => setSettings(p => ({ ...p, language: 'اردو' }))} /><Chip label="हिन्दी" active={settings.language === 'हिन्दी'} onPress={() => setSettings(p => ({ ...p, language: 'हिन्दी' }))} /></View><Text style={[styles.tinyNote, { color: c.muted }]}>The selected language currently changes speech output preference; full interface localization and AI translation are still development work.</Text>
    </Card>
    <Card><SectionTitle title="Privacy and security" />
      <SettingToggle title="Biometric app lock" subtitle="Request fingerprint / face unlock when reopening" value={settings.biometrics} onChange={v => void changeBiometric(v)} disabled={demoMode} />
      <SettingToggle title="Show sensitive records" subtitle="Sensitive records are hidden by default on Home and Records" value={settings.showHidden} onChange={v => setSettings(p => ({ ...p, showHidden: v }))} />
      <SettingToggle title="AI processing consent" subtitle="Allow selected documents to be sent to the configured AI server when you explicitly ask it to read them" value={settings.aiConsent} onChange={v => { if (v) Alert.alert('AI processing consent', 'Only selected documents are sent to the configured AI service when you explicitly request extraction. Check the provider’s data terms before using real health records.', [{ text: 'Cancel', style: 'cancel' }, { text: 'I understand', onPress: () => setSettings(p => ({ ...p, aiConsent: true })) }]); else setSettings(p => ({ ...p, aiConsent: false })); }} />
      <View style={[styles.infoLine, { backgroundColor: c.surface }]}><MaterialCommunityIcons name="shield-lock-outline" size={22} color={c.primary} /><Text style={{ color: c.text, fontSize: 12, lineHeight: 18, flex: 1 }}>Authentication session tokens use device secure storage. Cached records and original files are stored in app-private local storage, but this app does not yet implement a user-held encryption key / end-to-end encryption. Do not use real patient records until the security review is complete.</Text></View>
    </Card>
    <Card><SectionTitle title="Your data" /><AppButton title="Export all records as PDF" icon="file-pdf-box" secondary onPress={() => void exportPdf('all')} /><AppButton title="Sync pending + refresh" icon="cloud-sync-outline" secondary disabled={!isRealUser || loading} onPress={() => void syncCloudNow(true)} /><AppButton title="Delete everything" icon="delete-sweep-outline" danger onPress={deleteEverything} /><Text style={[styles.tinyNote, { color: c.muted }]}>Delete-all is irreversible. Cloud deletion requires the latest schema and valid sign-in. Back up records that you need first.</Text></Card>
    <Card><SectionTitle title="Plan" /><View style={styles.planRow}><View style={{ flex: 1 }}><Text style={{ color: c.text, fontWeight: '800' }}>Free</Text><Text style={{ color: c.muted, fontSize: 12, marginTop: 4 }}>Basic import, organisation, manual search, limited AI usage</Text></View><Chip label="Preview" active /></View><View style={styles.planRow}><View style={{ flex: 1 }}><Text style={{ color: c.text, fontWeight: '800' }}>Pro</Text><Text style={{ color: c.muted, fontSize: 12, marginTop: 4 }}>Higher AI limits, smart search, cloud backup, family tools</Text></View><Chip label="Not billed" /></View><Text style={[styles.tinyNote, { color: c.muted }]}>Plan descriptions are a product mock-up. Payments, enforcement, storage quotas and usage limits need a billing and server policy integration.</Text></Card>
