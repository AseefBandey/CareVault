# ==============================================================================
# CareVault Web & Server Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your external services credentials.
# ==============================================================================

# Browser client (Supabase public credentials)
VITE_SUPABASE_URL="ENTER_YOUR_SUPABASE_URL_HERE"
VITE_SUPABASE_ANON_KEY="ENTER_YOUR_SUPABASE_ANON_KEY_HERE"
VITE_API_BASE_URL=/api

# Server-only variables (Never expose to browser)
SUPABASE_URL="ENTER_YOUR_SUPABASE_URL_HERE"
SUPABASE_ANON_KEY="ENTER_YOUR_SUPABASE_ANON_KEY_HERE"

# Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="ENTER_YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL=gemini-2.5-flash

# API Server port and origin
API_PORT=8787
APP_ORIGIN=http://localhost:3000
